---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

// Mighty Bison is a permanent beast buff: +1,500 squad-core per level (Lv. 1–10).
// It lands in the squad core, so it scales with the deployment buff like every
// other core bonus — the option VALUE is the bonus itself, so the engine can add
// it without a lookup table.
const BISON_LEVELS = Array.from({ length: 10 }, (_, i) => {
  const bonus = (i + 1) * 1500;
  return { value: String(bonus), label: `Lv. ${i + 1} (+${bonus.toLocaleString('en-US')})` };
});
---

<Layout title="Vikings Vengeance Squad Calculator — Kingdom 1516">
  <main class="calculator">
    <header class="calc-header">
      <h1 class="calc-title">Vikings Vengeance Squad Calculator</h1>
      <p class="calc-sub">Plan your 6 full marches.</p>
    </header>

    <div class="calc-grid">
      <!-- ============ INPUTS ============ -->
      <section class="inputs" aria-label="Inputs">
        <div class="calc-card">
          <h2 class="card-title">Troop Pool</h2>
          <!-- Sample pools sized for what the event actually asks for: 6 full marches
               of 130,710 at the default 60/40/0 ratio need 470,556 Infantry and
               313,704 Cavalry. Smaller pools run a budget dry mid-fill and deploy
               archers at untouched defaults, which contradicts the whole point of
               the event. -->
          <div class="row3">
            <div class="field"><label class="field-label t-inf" for="tInf">Infantry</label><input id="tInf" type="number" min="0" value="480000"></div>
            <div class="field"><label class="field-label t-cav" for="tCav">Cavalry</label><input id="tCav" type="number" min="0" value="320000"></div>
            <div class="field"><label class="field-label t-arch" for="tArch">Archers</label><input id="tArch" type="number" min="0" value="429106"></div>
          </div>
        </div>

        <div class="calc-card">
          <h2 class="card-title">March &amp; Buffs</h2>
          <div class="field"><label class="field-label" for="squadBase">Squad base cap</label><input id="squadBase" type="number" min="0" value="130710"></div>
          <div class="row2">
            <div class="field">
              <label class="field-label" for="marshalTier">Marshal buff <span class="tag">temporary</span></label>
              <select id="marshalTier">
                <option value="0">None</option>
                <option value="marshal">+2,500</option>
                <option value="mid">+3,750</option>
                <option value="big">+5,000</option>
              </select>
            </div>
            <div class="field">
              <label class="field-label" for="deploy">Deployment buff <span class="tag">temporary</span></label>
              <select id="deploy">
                <option value="0">0%</option>
                <option value="0.1">10%</option>
                <option value="0.2">20%</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label class="field-label" for="bisonLevel">Mighty Bison <span class="tag">permanent</span></label>
            <select id="bisonLevel">
              <option value="0">None</option>
              {BISON_LEVELS.map((b) => <option value={b.value}>{b.label}</option>)}
            </select>
          </div>
        </div>

        <div class="calc-card">
          <h2 class="card-title">Distribution</h2>

          <div class="ratio">
            <span class="field-label">Ratio <span class="tag">all 6 marches</span> — Inf / Cav / Arch (%)</span>
            <div class="row3">
              <span class="num-suffix" data-suffix="%"><input id="rInfA" type="number" min="0" value="60" aria-label="Ratio Infantry percent"></span>
              <span class="num-suffix" data-suffix="%"><input id="rCavA" type="number" min="0" value="40" aria-label="Ratio Cavalry percent"></span>
              <span class="num-suffix" data-suffix="%"><input id="rArchA" type="number" min="0" value="0" aria-label="Ratio Archer percent"></span>
            </div>
          </div>

          <p class="hint">Each march gets the Inf / Cav / Arch split you set, so an archer share you ask for is sent as asked. Any gap fills Infantry first, then Cavalry — archers beyond your share only once both of those budgets are exhausted, and you get a warning when that happens.</p>
        </div>
      </section>

      <!-- ============ RESULTS ============ -->
      <section class="results" aria-label="Results">
        <div id="warnings"></div>

        <div class="calc-card stats">
          <div class="stat">
            <span class="stat-label">March size</span>
            <span class="stat-formula" id="squadFormula"></span>
            <span class="stat-value"><span id="squadSize"></span> <small>troops</small></span>
          </div>
          <div class="stat">
            <span class="stat-label">Troops for 6 full marches</span>
            <span class="stat-formula">6 × march size</span>
            <span class="stat-value"><span id="marchesTotal"></span> <small>troops</small></span>
          </div>
        </div>

        <div class="calc-card">
          <h2 class="card-title">What to send where</h2>
          <div class="table-wrap">
            <table class="result-table" id="sendTable"></table>
          </div>
          <div class="btnrow">
            <button type="button" class="btn" id="copyBtn"><Icon name="clipboard" /> <span class="btn-label">Copy formation</span></button>
            <button type="button" class="btn" id="shareBtn"><Icon name="link" /> <span class="btn-label">Copy share link</span></button>
          </div>
        </div>

        <div class="calc-card">
          <h2 class="card-title">Diagnostics</h2>
          <div class="diag">
            <div class="diag-box"><span class="diag-k">Missing for perfect ratio (Inf)</span><span class="v" id="mInf"></span></div>
            <div class="diag-box"><span class="diag-k">Missing (Cav)</span><span class="v" id="mCav"></span></div>
            <div class="diag-box"><span class="diag-k">Missing (Arch)</span><span class="v" id="mArch"></span></div>
            <div class="diag-box"><span class="diag-k">Leftover after deploy (Inf)</span><span class="v" id="lInf"></span></div>
            <div class="diag-box"><span class="diag-k">Leftover (Cav)</span><span class="v" id="lCav"></span></div>
            <div class="diag-box"><span class="diag-k">Leftover (Arch)</span><span class="v" id="lArch"></span></div>
          </div>
        </div>

        <div class="calc-card">
          <h2 class="card-title">All 12 squad sizes</h2>
          <div class="table-wrap">
            <table class="grid9">
              <thead>
                <tr>
                  <th></th>
                  <th class="num">0%</th>
                  <th class="num">10%</th>
                  <th class="num">20%</th>
                </tr>
              </thead>
              <tbody id="grid9body"></tbody>
            </table>
          </div>
          <p class="hint">Highlighted = your current Marshal / Deployment combination.</p>
        </div>
      </section>
    </div>

    <!-- ============ EXPLAINER + FAQ ============ -->
    <div class="explainer-grid">
      <div class="calc-card">
        <h2 class="card-title">How this calculator works</h2>
        <ol class="how">
          <li>Start from your <strong>squad base cap</strong>, then apply Mighty Bison, Marshal and Deployment buffs to find your true <strong>march size</strong>.</li>
          <li>Split your troop pool into <strong>6 equal budgets</strong> — one per march, a sixth of every troop type.</li>
          <li>Fill each march up to the march size with your <strong>Inf / Cav / Arch ratio</strong>, archer share included — then fill any gap by priority: <strong>Infantry, then Cavalry</strong>, archers beyond your share only once both are exhausted.</li>
          <li>Report leftover troops, any shortfall against a perfect ratio, and a warning whenever the pool cannot fill all 6 marches.</li>
        </ol>
      </div>

      <div class="calc-card">
        <h2 class="card-title">FAQ</h2>
        <div class="faq">
          <h3 class="faq-q">Does the ratio have to add up to 100?</h3>
          <p class="faq-a">It doesn't have to — the calculator normalizes your Inf / Cav / Arch values, so 50 / 30 / 20 and 5 / 3 / 2 give the same split.</p>
          <h3 class="faq-q">Can I really send 0 archers?</h3>
          <p class="faq-a">Yes — set the archer share to 0 and none are sent. An archer share you do set is deployed as asked; beyond it archers appear only when both the Infantry and the Cavalry budget are exhausted, and only that case raises a warning.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Troop-type tints are decorative: readable on the LIGHT parchment by default,
     swapped to the brighter legacy hues on the DARK canvas. Numbers themselves
     stay --color-ink — readability wins over the tint. */
  .calculator {
    --inf: #2563a8;
    --cav: #a4621d;
    --arch: #2f8f4e;

    max-width: 1180px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }

  .calc-header {
    margin-bottom: var(--space-4);
  }
  .calc-title {
    font-size: clamp(26px, 5vw, 34px);
    line-height: 1.1;
    color: var(--color-ink);
  }
  .calc-sub {
    color: var(--color-muted);
    font-size: 15px;
    margin: var(--space-2) 0 0;
  }

  /* ===== Layout: single-column mobile, Inputs/Results split on desktop ===== */
  .calc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  .explainer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  /* ===== Card frame (flat: hairline border + token surface, calm) ===== */
  .calc-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    margin-bottom: var(--space-4);
  }
  .results .calc-card:last-child,
  .inputs .calc-card:last-child {
    margin-bottom: 0;
  }
  .card-title {
    font-size: 17px;
    color: var(--color-ink);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  /* ===== Inputs ===== */
  /* minmax(0,1fr) lets fields shrink below intrinsic width instead of overflowing. */
  .row2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .row3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .row2 + .row2 {
    margin-top: var(--space-3);
  }
  .field {
    display: flex;
    flex-direction: column;
  }
  .field-label {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-muted);
    margin: var(--space-3) 0 var(--space-2);
    line-height: 1.3;
  }
  /* push paired controls to a shared baseline when one label wraps */
  .field .field-label {
    white-space: nowrap;
  }
  .field input,
  .field select {
    margin-top: auto;
  }

  .calc-card input[type="number"],
  .calc-card select {
    width: 100%;
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-body);
    /* 16px keeps iOS Safari from auto-zooming the page on focus */
    font-size: 16px;
  }
  .calc-card select {
    text-align: left;
  }
  .calc-card input[type="number"]:hover,
  .calc-card select:hover {
    border-color: var(--color-primary);
  }
  .calc-card input[type="number"]:focus,
  .calc-card select:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: var(--color-primary);
  }

  /* unit suffix (e.g. %) shown to the right of a right-aligned numeric field */
  .num-suffix {
    position: relative;
    display: block;
  }
  .num-suffix input {
    padding-right: 24px;
  }
  .num-suffix::after {
    content: attr(data-suffix);
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-muted);
    font-size: 13px;
    pointer-events: none;
  }

  .tag {
    font-size: 10.5px;
    color: var(--color-muted);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 1px 8px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Used on BOTH the static field labels and the JS-injected result-table column
     headers. Globalize (anchored under .calculator) so the injected headers tint too. */
  .calculator :global(.t-inf) { color: var(--inf); }
  .calculator :global(.t-cav) { color: var(--cav); }
  .calculator :global(.t-arch) { color: var(--arch); }

  .ratio {
    margin-top: var(--space-2);
  }
  .ratio .field-label {
    white-space: normal;
  }

  .hint {
    font-size: 12px;
    color: var(--color-muted);
    line-height: 1.5;
    margin: var(--space-4) 0 0;
  }

  /* ===== Stats / totals cards ===== */
  .stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .7px;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .stat-formula {
    font-size: 11.5px;
    color: var(--color-muted);
    min-height: 1.3em;
    line-height: 1.3;
  }
  .stat-value {
    font-size: 26px;
    font-weight: 700;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    margin-top: 2px;
  }
  .stat-value small {
    font-size: 12px;
    color: var(--color-muted);
    font-weight: 400;
  }

  /* ===== Results table (calm: hairline rows, no zebra, tracked header) =====
     The table body/head/foot are built by client JS via innerHTML, so those nodes
     never receive this component's scope attribute. Anchor each rule on the static
     .calculator root and :global() the injected part so the rows are styled. */
  .result-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
  }
  .calculator :global(.result-table thead th) {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .8px;
    color: var(--color-muted);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1.5px solid var(--color-border);
    text-align: right;
  }
  .calculator :global(.result-table thead th:first-child) {
    text-align: left;
  }
  .calculator :global(.result-table tbody th[scope="row"]),
  .calculator :global(.result-table tfoot th) {
    text-align: left;
    font-weight: 600;
    color: var(--color-ink);
    padding: var(--space-3);
    white-space: nowrap;
  }
  .calculator :global(.result-table tbody td),
  .calculator :global(.result-table tfoot td) {
    padding: var(--space-3);
    color: var(--color-ink);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .calculator :global(.result-table tbody th),
  .calculator :global(.result-table tbody td) {
    border-bottom: 1px solid var(--color-border);
  }
  .calculator :global(.total-row th),
  .calculator :global(.total-row td) {
    font-weight: 700;
    border-top: 1.5px solid var(--color-border);
  }

  .btnrow {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 13.5px;
    cursor: pointer;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-button);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-hover);
  }
  .btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ===== Diagnostics ===== */
  .diag {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .diag-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
  }
  .diag-k {
    display: block;
    font-size: 11.5px;
    color: var(--color-muted);
    line-height: 1.35;
  }
  .diag-box .v {
    display: block;
    margin-top: var(--space-1);
    font-size: 18px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .v.ok { color: var(--color-success); }
  .v.short { color: var(--color-danger); }
  /* The OK-state check icon is injected by JS (innerHTML), so the scoped .icon rule
     can't reach it — align it here. */
  .calculator :global(.v svg) { vertical-align: middle; }

  /* ===== 9-grid ===== */
  .grid9 {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
  }
  /* 9-grid body rows are JS-injected; globalize (anchored on .calculator) so they
     get centered/bordered and the current-combo .active highlight. The thead is
     static, so .grid9 thead th can stay scoped. */
  .calculator :global(.grid9 th),
  .calculator :global(.grid9 td) {
    text-align: center;
    font-size: 13px;
    padding: var(--space-2);
    font-variant-numeric: tabular-nums;
    border-bottom: 1px solid var(--color-border);
  }
  .grid9 thead th {
    color: var(--color-muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .6px;
  }
  .calculator :global(.grid9 th:first-child),
  .calculator :global(.grid9 td:first-child) {
    text-align: left;
    color: var(--color-muted);
  }
  .calculator :global(.grid9 tbody tr:last-child th),
  .calculator :global(.grid9 tbody tr:last-child td) {
    border-bottom: 0;
  }
  .calculator :global(.grid9 .active) {
    background: var(--color-highlight);
    color: var(--color-ink);
    font-weight: 700;
    border-radius: var(--radius-sm);
  }

  /* ===== Warnings ===== */
  /* The whole .warn banner is injected by client JS via innerHTML, so it needs the
     same .calculator-anchored :global() treatment as the result table. */
  .calculator :global(.warn) {
    background: color-mix(in srgb, var(--color-danger) 8%, transparent);
    border-left: 4px solid var(--color-danger);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
    font-size: 13px;
    line-height: 1.45;
  }
  /* The warning icon is injected by client JS, so Icon.astro's scoped .icon rule
     can't reach it — align it here (anchored on .calculator, :global() the injected svg). */
  .calculator :global(.warn svg) {
    vertical-align: middle;
  }

  /* ===== How it works + FAQ ===== */
  .how {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: 13.5px;
    color: var(--color-ink);
    line-height: 1.5;
  }
  .how strong {
    color: var(--color-primary-hover);
  }
  .faq {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .faq-q {
    font-size: 15px;
    color: var(--color-ink);
    margin: 0 0 var(--space-1);
  }
  .faq-a {
    font-size: 13.5px;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }

  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* ===== Desktop enhancement (single 768px breakpoint, mirrors the shell) ===== */
  @media (min-width: 520px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .diag {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    .calc-grid {
      grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
      align-items: start;
    }
    .explainer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ===== Dark "Royal Court" — the ONLY light-baked literals are the troop tints;
     every other surface is a role token that flips automatically (the wash-out
     guard). Swap the tints to the brighter dark-canvas hues. ===== */
  :global(:root[data-theme="dark"]) .calculator {
    --inf: #6fb6f1;
    --cav: #f0a564;
    --arch: #82da91;
  }
</style>

<script>
  /*
    Vikings Vengeance squad calculator. The event model: every player sends their
    OWN 6 FULL MARCHES — no rally, no joiners, no join cap. The troop pool splits
    into 6 equal per-type budgets and each march is filled up to the march size.
    Troop priority is INVERTED versus the Bear Trap: every march fills
    Infantry → Cavalry → Archers in a strict waterfall, so archers only ever
    deploy once both other budgets are spent.
    Deliberately absent (not forgotten): Valora, which is a bear-only buff; and
    the bear's 5,000 Inf/Cav floor with its Max-Archer mode — this event's target
    ratios (60/40/0, 70/30/0, 100/0/0) contain hard zeros that a floor would make
    unreachable.
  */
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  // Every input here is a count or percentage — none may be negative. Clamp at the
  // boundary so a typed/pasted negative can't render nonsense (negative troop counts,
  // sizes, ratios) downstream. `min="0"` on the inputs is not enforced for typed values.
  const num = (id: string) => { const v = parseFloat($(id).value); return isFinite(v) ? Math.max(0, v) : 0; };
  const fmt = (n: number) => Math.round(n).toLocaleString('en-US');

  // Lucide triangle-alert (lucide-static v1.22.0, ISC). Inlined because the warning
  // banner is built in client JS via innerHTML, where the build-time <Icon> component
  // can't run. Same convention as <Icon>: inline SVG, currentColor, 1em.
  const WARN_ICON = '<svg class="icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>';
  // Lucide check (lucide-static v1.22.0, ISC). Inlined for the same reason as WARN_ICON:
  // the OK diagnostics state is set via innerHTML, where the build-time <Icon> can't run.
  const CHECK_ICON = '<svg class="icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

  // The 'A' in the ratio ids is invisible to users and must stay: saved states and
  // share links already out there carry these exact ids, and a rename would silently
  // drop the ratio they hold.
  const INPUTS = ['tInf', 'tCav', 'tArch', 'squadBase', 'marshalTier', 'deploy', 'bisonLevel',
    'rInfA', 'rCavA', 'rArchA'];

  // fixed game constant
  const MARCHES = 6;   // the 6 full marches you send yourself

  const MARSHAL: Record<string, number> = { '0': 0, 'marshal': 2500, 'mid': 3750, 'big': 5000 };
  function marshalFlat() { return MARSHAL[($('marshalTier') as unknown as HTMLSelectElement).value] || 0; }

  // read & normalise the one ratio every march follows
  function readRatio() {
    const i = num('rInfA'), c = num('rCavA'), a = num('rArchA'), sum = i + c + a;
    return sum > 0 ? { inf: i / sum, cav: c / sum, arch: a / sum } : { inf: 0, cav: 0, arch: 0 };
  }

  // One march, filled in two passes so archers are a STRICT last resort. Pass 1 hands
  // every type its deliberate ratio share, bounded by its budget. Pass 2 places what
  // pass 1 could not — a shortfall of any type, an archer share the archer pool can't
  // deliver, or the floor() rounding remainder — strictly by priority, so archers get
  // the gap only after BOTH the infantry and the cavalry budget are exhausted. An empty
  // ratio (all three zero) therefore degrades to Infantry-then-Cavalry instead of
  // dumping the whole cap on archers. `lastResort` is the pass-2 archer amount, i.e.
  // exactly the archers deployed against your will. Name kept from the fuzz-proven
  // round-3 waterfall: only its budget and cap changed, never the fill itself.
  function fillJoiner(budget: any, ratio: any, cap: number) {
    const capInf = Math.floor(cap * ratio.inf), capCav = Math.floor(cap * ratio.cav),
      capArch = Math.floor(cap * ratio.arch);
    const inf1 = Math.min(budget.inf, capInf), cav1 = Math.min(budget.cav, capCav),
      arch1 = Math.min(budget.arch, capArch);
    let gap = cap - inf1 - cav1 - arch1;
    const inf2 = Math.min(budget.inf - inf1, gap); gap -= inf2;
    const cav2 = Math.min(budget.cav - cav1, gap); gap -= cav2;
    const arch2 = Math.min(budget.arch - arch1, gap);
    return { inf: inf1 + inf2, cav: cav1 + cav2, arch: arch1 + arch2, lastResort: arch2 };
  }

  function compute() {
    const troops = { inf: num('tInf'), cav: num('tCav'), arch: num('tArch') };
    const squadCore = num('squadBase') + num('bisonLevel');
    const deploy = num('deploy');
    const activeMarch = Math.round((squadCore + marshalFlat()) * (1 + deploy));

    const ratio = readRatio();

    // Every march draws on an equal sixth of each troop type and is capped by the
    // march size. A budget that runs dry shows up as a march below that size — the
    // under-fill warning names it rather than the page failing silently.
    const per = {
      inf: Math.floor(troops.inf / MARCHES),
      cav: Math.floor(troops.cav / MARCHES),
      arch: Math.floor(troops.arch / MARCHES)
    };

    // All 6 marches are identical — same budget, same ratio, so one fill describes
    // every one of them and the totals are just ×6.
    const march = fillJoiner(per, ratio, activeMarch);
    const target = { inf: Math.round(activeMarch * ratio.inf), cav: Math.round(activeMarch * ratio.cav), arch: Math.round(activeMarch * ratio.arch) };

    // Archers nobody wanted: the waterfall's pass-2 amount, across all 6 marches.
    const archBackfill = MARCHES * march.lastResort;

    const used = { inf: MARCHES * march.inf, cav: MARCHES * march.cav, arch: MARCHES * march.arch };
    const unused = {
      inf: troops.inf - used.inf,
      cav: troops.cav - used.cav,
      arch: troops.arch - used.arch
    };

    // missing to send the full ideal target in all 6 marches
    const missing = {
      inf: Math.max(0, MARCHES * target.inf - troops.inf),
      cav: Math.max(0, MARCHES * target.cav - troops.cav),
      arch: Math.max(0, MARCHES * target.arch - troops.arch)
    };

    // A march is short only when one of its budgets ran dry — the waterfall fills to
    // the cap otherwise, so testing the march size is enough.
    const underfilled = march.inf + march.cav + march.arch < activeMarch;

    return { squadCore, activeMarch, deploy, march, used, unused, missing, archBackfill, underfilled };
  }

  // The 6 identical marches collapse into ONE row: its cells are what a single march
  // sends, ×6 says how many marches carry that formation. The total row is the pool
  // actually spent.
  function renderTable(m: any) {
    const d = m.march;
    let h = '<thead><tr>'
      + '<th scope="col">March</th>'
      + '<th scope="col" class="t-inf">Infantry</th>'
      + '<th scope="col" class="t-cav">Cavalry</th>'
      + '<th scope="col" class="t-arch">Archer</th>'
      + '<th scope="col">Size</th>'
      + '</tr></thead><tbody>';

    h += `<tr><th scope="row">Marches ×${MARCHES}</th>`
      + `<td>${fmt(d.inf)}</td><td>${fmt(d.cav)}</td><td>${fmt(d.arch)}</td>`
      + `<td>${fmt(d.inf + d.cav + d.arch)}</td></tr>`;

    h += '</tbody><tfoot><tr class="total-row">'
      + '<th scope="row">Total used</th>'
      + `<td>${fmt(m.used.inf)}</td><td>${fmt(m.used.cav)}</td><td>${fmt(m.used.arch)}</td>`
      + `<td>${fmt(m.used.inf + m.used.cav + m.used.arch)}</td></tr></tfoot>`;

    $('sendTable').innerHTML = h;
  }

  function render() {
    const m = compute();

    // march size + totals
    const tierLbl: Record<string, string> = { '0': 'no Marshal', 'marshal': '+' + fmt(2500), 'mid': '+' + fmt(3750), 'big': '+' + fmt(5000) };
    $('squadFormula').textContent =
      `(${fmt(m.squadCore)} core, ${tierLbl[($('marshalTier') as unknown as HTMLSelectElement).value]}) × ${(1 + m.deploy).toFixed(2)}`;
    $('squadSize').textContent = fmt(m.activeMarch);
    $('marchesTotal').textContent = fmt(m.activeMarch * MARCHES);

    // results table (the shared march formation + total)
    renderTable(m);

    // diagnostics
    const setMiss = (id: string, v: number) => { const e = $(id); e.innerHTML = v > 0 ? '−' + fmt(v) : CHECK_ICON + ' 0'; e.className = 'v ' + (v > 0 ? 'short' : 'ok'); };
    setMiss('mInf', m.missing.inf); setMiss('mCav', m.missing.cav); setMiss('mArch', m.missing.arch);
    const setLeft = (id: string, v: number) => { const e = $(id); e.textContent = fmt(v); e.className = 'v ' + (v < 0 ? 'short' : ''); };
    setLeft('lInf', m.unused.inf); setLeft('lCav', m.unused.cav); setLeft('lArch', m.unused.arch);

    // 9-grid
    const deploys = [0, 0.1, 0.2];
    const tiers = [
      { key: '0', label: 'None', flat: 0 },
      { key: 'marshal', label: 'Marshal', flat: 2500 },
      { key: 'mid', label: 'Marshal +3,750', flat: 3750 },
      { key: 'big', label: 'Big Marshal', flat: 5000 }
    ];
    const selTier = ($('marshalTier') as unknown as HTMLSelectElement).value;
    const selDeploy = m.deploy;
    $('grid9body').innerHTML = tiers.map(t => {
      const cells = deploys.map(d => {
        const val = Math.round((m.squadCore + t.flat) * (1 + d));
        const active = (t.key === selTier && Math.abs(d - selDeploy) < 1e-9);
        return `<td class="${active ? 'active' : ''}">${fmt(val)}</td>`;
      }).join('');
      return `<tr><th scope="row">${t.label}</th>${cells}</tr>`;
    }).join('');

    // warnings
    const w: string[] = [];
    const ratioSum = num('rInfA') + num('rCavA') + num('rArchA');
    // A zero ratio normalizes to nothing at all — say what actually happens instead
    // of claiming a normalization the engine never performs.
    if (ratioSum === 0) w.push('Ratio is empty — marches fill by priority instead (Infantry → Cavalry → Archers).');
    else if (Math.abs(ratioSum - 100) > 0.001) w.push(`Ratio sums to ${fmt(ratioSum)}% instead of 100% — normalized automatically.`);
    if (m.underfilled)
      w.push('Not enough troops to fill all 6 full marches — they run smaller.');
    if (m.archBackfill > 0)
      w.push(`Archers had to deploy as a last resort: ${fmt(m.archBackfill)} across your ${MARCHES} marches, because the Infantry and Cavalry budgets ran out.`);
    $('warnings').innerHTML = w.map(x => `<div class="warn">${WARN_ICON} ${x}</div>`).join('');

    lastModel = m;
    saveState();
  }

  // ---- persistence (localStorage) + share link + copy-to-clipboard ----
  const STORAGE_KEY = 'vikingcalc.state';
  let lastModel: any = null;

  // Every INPUTS id is a number input or a <select>, so `.value` round-trips all of
  // them. Ids an older stored state or share link carries that this page no longer has
  // are simply absent from INPUTS and get ignored instead of throwing.
  function saveState() {
    const s: Record<string, any> = {}; INPUTS.forEach(id => s[id] = $(id).value);
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch (e) { }
  }
  function loadLocal() {
    try {
      const s = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (s) { INPUTS.forEach(id => { if (id in s) $(id).value = s[id]; }); return true; }
    } catch (e) { }
    return false;
  }
  function applyHash() {
    const h = location.hash.replace(/^#/, ''); if (!h) return false;
    const p = new URLSearchParams(h); let any = false;
    INPUTS.forEach(id => { if (p.has(id)) { $(id).value = p.get(id) ?? ''; any = true; } });
    return any;
  }
  function shareURL() {
    const p = new URLSearchParams(); INPUTS.forEach(id => p.set(id, $(id).value));
    return location.origin + location.pathname + '#' + p.toString();
  }

  function formationText() {
    const m = lastModel; if (!m) return '';
    const d = m.march;
    return [`🪓 Vikings Vengeance — ${MARCHES} marches, Inf / Cav / Arch`,
      `Marches: ${fmt(d.inf)} / ${fmt(d.cav)} / ${fmt(d.arch)}`].join('\n');
  }

  function copyText(text: string, btn: HTMLElement) {
    // Swap only the label span — not btn.textContent, which would delete the <Icon> SVG child.
    const label = btn.querySelector('.btn-label') as HTMLElement;
    // State lives on the button so a rapid second click can't snapshot "Copied" as the
    // original label (which would leave it stuck), and the restore timer restarts instead of stacking.
    const state = btn as HTMLElement & { _label?: string; _restore?: number };
    if (state._label === undefined) state._label = label.textContent ?? '';
    const flash = () => {
      label.textContent = 'Copied';
      clearTimeout(state._restore);
      state._restore = window.setTimeout(() => { label.textContent = state._label!; }, 1500);
    };
    const fallback = () => {
      const ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); flash(); } catch (e) { }
      document.body.removeChild(ta);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(flash).catch(fallback);
    else fallback();
  }

  ($('copyBtn') as unknown as HTMLElement).addEventListener('click', () => copyText(formationText(), $('copyBtn')));
  ($('shareBtn') as unknown as HTMLElement).addEventListener('click', () => copyText(shareURL(), $('shareBtn')));

  // ---- init ----
  // A shared #hash pre-fills the app once; otherwise restore the last saved state.
  const fromHash = applyHash();
  if (!fromHash) loadLocal();
  INPUTS.forEach(id => {
    const el = $(id); el.addEventListener('input', render); el.addEventListener('change', render);
  });
  render();
  // Consume the shared link: drop the #hash so live edits & refreshes use localStorage, not the stale snapshot.
  if (fromHash) { try { history.replaceState(null, '', location.pathname + location.search); } catch (e) { } }
</script>
