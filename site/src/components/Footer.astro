---
/*
  The IP disclaimer is the only required element — verbatim text, em-dash. No
  nav link row (redundant with the top bar + mobile tab bar); the Ko-fi support
  link is a proper button so it is actually seen. Donations stay strictly
  cost-covering (keeps the unofficial-fan-site posture). The footer is the
  site-wide home for the kingdom Discord link.
*/
import Icon from './Icon.astro';

const COFFEE_URL = 'https://ko-fi.com/saboras';
const DISCORD_URL = 'https://discord.gg/UvTNZyZvZd';
---

<footer class="site-footer">
  <p class="disclaimer">Unofficial fan site — not affiliated with or endorsed by Century Games.</p>
  <p class="support">
    <a class="support-btn" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">
      <Icon name="message-circle" /> Join the 1516 Discord
    </a>
    <a class="support-btn" href={COFFEE_URL} target="_blank" rel="noopener noreferrer">
      <Icon name="coffee" /> Buy me a coffee
    </a>
  </p>
  <p class="support-note">Donations help keep the server &amp; domain running.</p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4);
    padding: var(--space-6) var(--space-7);
    border-top: 2px solid var(--color-primary);
    background: linear-gradient(#F6EDD7, #FDF9EF);
    text-align: center;
  }
  /* Dark "Royal Court": the light-parchment gradient has no dark variant, but
     --color-muted/--color-accent text flips to light — remap the surface. */
  :global(:root[data-theme="dark"]) .site-footer {
    background: linear-gradient(var(--color-bg), var(--color-surface));
  }
  .disclaimer {
    font-size: 12.5px;
    color: var(--color-muted);
    margin: 0;
  }
  .support {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
  }
  /* Quiet-outline button (DESIGN button-secondary family) — visible, but never
     competing with the gold primary CTAs on the pages above it. */
  .support-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    text-decoration: none;
  }
  .support-btn:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .support-note {
    margin: var(--space-2) 0 0;
    font-size: 12px;
    color: var(--color-muted);
  }
</style>
